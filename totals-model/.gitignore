__pycache__/
*.pyc

# tools_check_*_page.js drives a real browser through Playwright, which is not
# declared anywhere because the browser itself is already on the machine
# (CHROMIUM_PATH, defaulting to /opt/pw-browsers/chromium). Running the checks
# means `npm install playwright` first, and that drops these three in the
# working tree. They are a dependency download, not part of the project.
node_modules/
package.json
package-lock.json

# The slate script writes its daily files next to itself when run there.
slate/slate-*.json
slate/grade-*.json
slate/nhl-slate-*.json
slate/nhl-grade-*.json
slate/odds-*.json
slate/odds-log.json

# The Odds API key. This repository is public, so the key must never land in
# it: the script reads it from this file beside itself, and nowhere else.
odds_key.txt
